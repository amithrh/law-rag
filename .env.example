# =============================================================================
# law-rag — environment configuration
# Copy to .env and adjust. .env is gitignored.
# =============================================================================

# --- Postgres (pgvector) -----------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lawrag
POSTGRES_USER=lawrag
POSTGRES_PASSWORD=change-me-locally
# host-mapped port (set to a free local port; 5432 may already be in use)
POSTGRES_HOST_PORT=5433

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# --- Ollama (LLM + embeddings on Mac dev) ------------------------------------
# Host the API process calls for generation. Host-side Mac dev should use
# 127.0.0.1 to avoid Docker/OrbStack localhost ambiguity; containerized prod
# should set OLLAMA_API_HOST=ollama.
OLLAMA_API_HOST=127.0.0.1
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_HOST_PORT=11434
# Default LLM for dev (8B q4_K_M fits on 32 GB Mac comfortably).
# For prod (Linux + GPU) swap to llama-3.3-70b-instruct-q4_K_M or qwen2.5-72b-instruct-q4_K_M
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_FALLBACK_MODEL=qwen2.5:7b-instruct-q4_K_M
# Embeddings: served by Ollama on Mac (Metal-accelerated, native arm64).
# On Linux prod, swap to TEI on CUDA via infra/docker-compose.prod.yml.
OLLAMA_EMBED_MODEL=bge-m3

# --- TEI (Linux prod only — Mac uses Ollama for embeddings) ------------------
# TEI doesn't publish an arm64 CPU image. On Mac dev, the `tei` service is
# omitted from docker-compose.yml and Ollama serves bge-m3 embeddings.
# These vars are set so apps/api can detect production mode and route accordingly.
EMBEDDING_BACKEND=ollama         # 'ollama' on Mac, 'tei' on Linux prod
TEI_HOST=tei
TEI_PORT=80
TEI_HOST_PORT=8080
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.5  # CUDA tag for prod
TEI_MODEL_ID=BAAI/bge-m3
TEI_MAX_BATCH_TOKENS=16384

# --- MinIO (raw PDFs + OCR text) --------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
MINIO_ROOT_USER=lawrag-minio
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_BACKUPS=backups

# --- API / Web (filled in once Days 8+ land) --------------------------------
API_PORT=8000
WEB_PORT=3000

# --- Verifier (§4.3) --------------------------------------------------------
# NLI checkpoint for entailment scoring
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli
# Strictness: 0 = stop on any unsupported sentence (public-product default per §4.3).
# Raise only behind explicit flag for evaluation.
SKIP_RATIO_STOP=0
# Per-sentence NLI threshold below which we mark weak_support
NLI_WEAK_SUPPORT_BELOW=0.5

# --- Eval -------------------------------------------------------------------
# Set to "claude" to use Claude API as offline judge for answer_correctness.
# Out-of-band from "fully local OSS at runtime" — eval only.
EVAL_JUDGE=local
ANTHROPIC_API_KEY=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
RAG_USER_AGENT="IndianLawRAG-research/0.1 (+contact@example.com)"
